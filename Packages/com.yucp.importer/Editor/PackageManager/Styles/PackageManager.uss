/* ============================================================================
   YUCP Package Manager — Redesigned UI
   Modern · Sleek · Minimal · Beautiful
   ============================================================================ */

/* ============================================================================
   BANNER SECTION
   ============================================================================ */
.yucp-banner-container {
    position: relative;
    height: 75%;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
}

.yucp-banner-image-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(42, 42, 47, 1.0);
    background-size: cover;
    background-position: center;
}

.yucp-banner-image-empty {
    background-color: rgba(42, 42, 47, 1.0);
}

/* Crossfade overlay: sits between the banner image and gradient */
.yucp-banner-fade-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-in-out;
}

.yucp-banner-fade-overlay.yucp-fade-active {
    opacity: 1;
}

.yucp-banner-gradient-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-size: 100% 100%;
    background-position: center;
    background-repeat: no-repeat;
}

/* ============================================================================
   BASE SECTION CARD
   ============================================================================ */
.yucp-section {
    background-color: rgba(8, 8, 11, 0.72);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 18px;
}

/* ============================================================================
   INSTALLER SUMMARY (Package info card — import wizard)
   ============================================================================ */
.yucp-installer-summary {
    background-color: rgba(10, 10, 14, 0.86);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 18px;
    padding-bottom: 22px;
}

.yucp-metadata-section {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 10px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: transparent;
}

.yucp-metadata-header {
    flex-direction: row;
    align-items: flex-start;
    flex-wrap: wrap;
    min-width: 0;
    padding-bottom: 0;
}

.yucp-action-buttons-container {
    flex-shrink: 0;
    min-width: 0;
    flex-direction: row;
    align-items: flex-start;
    margin-left: 14px;
}

/* Icon */
.yucp-metadata-icon-container {
    width: 80px;
    height: 80px;
    min-width: 80px;
    min-height: 80px;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
}

.yucp-metadata-icon-image-container {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
}

.yucp-metadata-icon-image {
    position: absolute;
    width: 107%;
    height: 107%;
    left: -3.5%;
    top: -3.5%;
}

/* Name / text */
.yucp-metadata-name-field {
    font-size: 19px;
    -unity-font-style: bold;
    color: #f2f2f4;
    margin-bottom: 0;
}

.yucp-ellipsis-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.yucp-metadata-section Label {
    color: #f2f2f4;
}

.yucp-package-context-label {
    color: rgba(255, 255, 255, 0.38);
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.yucp-package-author-label {
    color: rgba(240, 240, 244, 0.52);
    font-size: 12px;
    margin-top: 3px;
}

.yucp-version-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.yucp-version-row Label {
    color: rgba(240, 240, 244, 0.65);
    font-size: 12px;
}

.yucp-package-description {
    color: rgba(220, 220, 226, 0.72);
    font-size: 12px;
    margin-top: 10px;
    white-space: normal;
}

.yucp-product-link-container {}
.yucp-product-link-label {}

/* ============================================================================
   DETAILS TOGGLE — VisualElement row, full custom styling, no Button chrome
   ============================================================================ */

/* Outer row — the whole clickable strip */
.yucp-dtb {
    flex-direction: row;
    align-items: stretch;
    margin-top: 8px;
    min-height: 46px;
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    overflow: hidden;
    cursor: link;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.yucp-dtb:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

/* Teal left accent bar — hidden */
.yucp-dtb-accent {
    display: none;
}

/* Icon (≡ or ←) */
.yucp-dtb-icon {
    font-size: 15px;
    color: rgba(224, 224, 230, 0.72);
    margin-left: 14px;
    margin-right: 10px;
    flex-shrink: 0;
    width: 18px;
    -unity-text-align: middle-center;
    align-self: center;
}

/* Main label */
.yucp-dtb-text {
    font-size: 12px;
    -unity-font-style: normal;
    color: rgba(224, 224, 230, 0.85);
    align-self: center;
    flex-shrink: 0;
}

/* Count badge (file/dep indicator) */
.yucp-dtb-count {
    font-size: 10px;
    color: rgba(224, 224, 230, 0.62);
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 10px;
    flex-shrink: 0;
    align-self: center;
}

/* Right chevron › */
.yucp-dtb-arrow {
    font-size: 18px;
    color: rgba(210, 210, 216, 0.28);
    margin-right: 14px;
    flex-shrink: 0;
    align-self: center;
}

/* Keep the old class name around in case anything still references it */
.yucp-details-toggle-button {
    display: none;
}

/* ============================================================================
   ACTION BUTTONS
   ============================================================================ */
.yucp-action-button {
    min-width: 84px;
    min-height: 34px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 7px;
    padding-bottom: 7px;
    font-size: 12px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    color: #f2f2f4;
    margin-left: 8px;
    transition-duration: 0.14s;
    transition-property: background-color, opacity;
}

.yucp-cancel-button {
    background-color: rgba(255, 255, 255, 0.06);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    color: rgba(240, 240, 244, 0.80);
}

.yucp-cancel-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.yucp-import-button {
    background-color: rgba(255, 255, 255, 0.95);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.28);
    border-right-color: rgba(255, 255, 255, 0.28);
    border-bottom-color: rgba(255, 255, 255, 0.28);
    border-left-color: rgba(255, 255, 255, 0.28);
    color: rgba(14, 14, 16, 0.96);
}

.yucp-import-button Label {
    color: rgba(14, 14, 16, 0.96);
}

.yucp-import-button:hover {
    background-color: rgba(255, 255, 255, 1.0);
}

/* ============================================================================
   BRANDED MODAL DIALOGS
   ============================================================================ */
.yucp-dialog-installer-root {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(17, 17, 20, 1.0);
}

.yucp-dialog-banner-section {
    position: relative;
    flex-shrink: 0;
    height: 210px;
    width: 100%;
    overflow: hidden;
    background-color: rgba(42, 42, 47, 1.0);
}

.yucp-dialog-banner-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(42, 42, 47, 1.0);
    background-size: cover;
    -unity-background-scale-mode: scale-and-crop;
}

.yucp-dialog-banner-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.yucp-dialog-hero-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: flex-end;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 17px;
}

.yucp-dialog-hero-icon {
    width: 62px;
    height: 62px;
    min-width: 62px;
    min-height: 62px;
    max-width: 62px;
    max-height: 62px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.20);
    border-right-color: rgba(255, 255, 255, 0.20);
    border-bottom-color: rgba(255, 255, 255, 0.20);
    border-left-color: rgba(255, 255, 255, 0.20);
    background-color: rgba(0, 0, 0, 0.18);
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.yucp-dialog-hero-icon-image {
    width: 62px;
    height: 62px;
    -unity-background-scale-mode: scale-to-fit;
}

.yucp-dialog-hero-icon-text {
    color: rgba(255, 255, 255, 0.96);
    font-size: 22px;
    -unity-font-style: bold;
}

.yucp-dialog-hero-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 14px;
    margin-bottom: 3px;
}

.yucp-dialog-hero-eyebrow {
    color: rgba(240, 240, 244, 0.52);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
}

.yucp-dialog-hero-title {
    color: rgba(255, 255, 255, 1.0);
    font-size: 21px;
    -unity-font-style: bold;
    white-space: normal;
}

.yucp-dialog-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 18px;
}

.yucp-dialog-body-text {
    color: rgba(224, 224, 230, 0.76);
    font-size: 12px;
    white-space: normal;
}

.yucp-dialog-body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    max-height: 280px;
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.yucp-dialog-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 16px;
    padding-bottom: 20px;
}

.yucp-dialog-action {
    min-width: 134px;
    margin-left: 10px;
}

.yucp-error-dialog-root {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(239, 239, 244, 1.0);
}

.dark .yucp-error-dialog-root {
    background-color: rgba(239, 239, 244, 1.0);
}

.yucp-error-dialog-surface {
    background-color: rgba(239, 239, 244, 1.0);
}

.dark .yucp-error-dialog-surface {
    background-color: rgba(239, 239, 244, 1.0);
}

.yucp-error-dialog-header {
    flex-shrink: 0;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 24px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(20, 20, 26, 0.10);
}

.dark .yucp-error-dialog-header {
    border-bottom-color: rgba(20, 20, 26, 0.10);
}

.yucp-error-dialog-header-row {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.yucp-error-dialog-brand-mark {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(255, 255, 255, 0.86);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(20, 20, 26, 0.10);
    border-right-color: rgba(20, 20, 26, 0.10);
    border-bottom-color: rgba(20, 20, 26, 0.10);
    border-left-color: rgba(20, 20, 26, 0.10);
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.dark .yucp-error-dialog-brand-mark {
    background-color: rgba(255, 255, 255, 0.86);
    border-top-color: rgba(20, 20, 26, 0.10);
    border-right-color: rgba(20, 20, 26, 0.10);
    border-bottom-color: rgba(20, 20, 26, 0.10);
    border-left-color: rgba(20, 20, 26, 0.10);
}

.yucp-error-dialog-brand-image {
    width: 46px;
    height: 46px;
    -unity-background-scale-mode: scale-to-fit;
}

.yucp-error-dialog-brand-text {
    color: rgba(20, 20, 26, 0.90);
    font-size: 19px;
    -unity-font-style: bold;
}

.dark .yucp-error-dialog-brand-text {
    color: rgba(20, 20, 26, 0.90);
}

.yucp-error-dialog-title-stack {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 14px;
}

.yucp-error-dialog-eyebrow {
    color: rgba(20, 20, 26, 0.46);
    font-size: 9px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.dark .yucp-error-dialog-eyebrow {
    color: rgba(20, 20, 26, 0.46);
}

.yucp-error-dialog-title {
    color: rgba(17, 17, 22, 0.96);
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.dark .yucp-error-dialog-title {
    color: rgba(17, 17, 22, 0.96);
}

.yucp-error-dialog-summary {
    color: rgba(224, 224, 230, 0.70);
    font-size: 12px;
    margin-bottom: 14px;
    white-space: normal;
}

.yucp-error-dialog-details-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    max-height: 260px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    background-color: rgba(0, 0, 0, 0.28);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-error-dialog-details {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.0);
    color: rgba(232, 198, 198, 0.92);
    font-size: 12px;
    white-space: normal;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.yucp-error-dialog-details > TextInput {
    background-color: rgba(0, 0, 0, 0.0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgba(232, 198, 198, 0.92);
}

.yucp-error-dialog-action-row {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 16px;
    padding-bottom: 22px;
}

.yucp-error-dialog-copy-button {
    min-width: 118px;
    min-height: 38px;
    margin-right: 10px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(255, 255, 255, 0.62);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(20, 20, 26, 0.13);
    border-right-color: rgba(20, 20, 26, 0.13);
    border-bottom-color: rgba(20, 20, 26, 0.13);
    border-left-color: rgba(20, 20, 26, 0.13);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    color: rgba(20, 20, 26, 0.76);
    font-size: 12px;
}

.dark .yucp-error-dialog-copy-button {
    background-color: rgba(255, 255, 255, 0.62);
    border-top-color: rgba(20, 20, 26, 0.13);
    border-right-color: rgba(20, 20, 26, 0.13);
    border-bottom-color: rgba(20, 20, 26, 0.13);
    border-left-color: rgba(20, 20, 26, 0.13);
    color: rgba(20, 20, 26, 0.76);
}

.yucp-error-dialog-copy-button:hover {
    background-color: rgba(255, 255, 255, 0.86);
    color: rgba(20, 20, 26, 0.92);
}

.dark .yucp-error-dialog-copy-button:hover {
    background-color: rgba(255, 255, 255, 0.86);
    color: rgba(20, 20, 26, 0.92);
}

.yucp-error-dialog-ok-button {
    min-width: 96px;
    min-height: 38px;
    padding-left: 18px;
    padding-right: 18px;
    background-color: rgba(17, 17, 22, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(17, 17, 22, 0.96);
    border-right-color: rgba(17, 17, 22, 0.96);
    border-bottom-color: rgba(17, 17, 22, 0.96);
    border-left-color: rgba(17, 17, 22, 0.96);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    color: rgba(255, 255, 255, 0.94);
    font-size: 12px;
}

.dark .yucp-error-dialog-ok-button {
    background-color: rgba(17, 17, 22, 0.96);
    border-top-color: rgba(17, 17, 22, 0.96);
    border-right-color: rgba(17, 17, 22, 0.96);
    border-bottom-color: rgba(17, 17, 22, 0.96);
    border-left-color: rgba(17, 17, 22, 0.96);
    color: rgba(255, 255, 255, 0.94);
}

.yucp-error-dialog-ok-button:hover {
    background-color: rgba(0, 0, 0, 1.0);
    color: rgba(255, 255, 255, 1.0);
}

.dark .yucp-error-dialog-ok-button:hover {
    background-color: rgba(0, 0, 0, 1.0);
    color: rgba(255, 255, 255, 1.0);
}

.yucp-error-dialog-ok-button Label {
    color: rgba(255, 255, 255, 0.94);
}

.dark .yucp-error-dialog-ok-button Label {
    color: rgba(255, 255, 255, 0.94);
}

/* ============================================================================
   INSTALLER-ONLY IDLE SURFACE
   ============================================================================ */
.yucp-installer-placeholder {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    background-color: rgba(17, 17, 20, 1.0);
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 28px;
    padding-bottom: 28px;
}

.yucp-installer-placeholder-icon {
    width: 58px;
    height: 58px;
    margin-bottom: 14px;
}

.yucp-installer-placeholder-eyebrow {
    color: rgba(255, 255, 255, 0.34);
    font-size: 9px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.yucp-installer-placeholder-title {
    color: #f2f2f4;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.yucp-installer-placeholder-body {
    color: rgba(224, 224, 230, 0.66);
    font-size: 12px;
    white-space: normal;
    margin-top: 9px;
}

.yucp-installer-placeholder-actions {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-top: 18px;
    margin-left: -8px;
}

/* ============================================================================
   CONTENTS SECTION
   ============================================================================ */
.yucp-contents-section {
    overflow: hidden;
    flex-shrink: 1;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 22px;
    margin-top: 0;
}

.yucp-details-header {
    margin-bottom: 14px;
}

.yucp-details-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.28);
    letter-spacing: 0.5px;
    margin-bottom: 3px;
}

.yucp-details-subtitle {
    color: rgba(210, 210, 216, 0.42);
    font-size: 11px;
    white-space: normal;
}

/* ============================================================================
   CONFLICT MODE (Replace / Keep segment control)
   ============================================================================ */
.yucp-conflict-mode-section {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.yucp-conflict-mode-label {
    color: rgba(218, 218, 224, 0.70);
    font-size: 12px;
    -unity-font-style: bold;
}

.yucp-conflict-segment {
    flex-direction: row;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-left-color: rgba(255, 255, 255, 0.07);
}

.yucp-conflict-option {
    min-height: 26px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: transparent;
    border-width: 0;
    color: rgba(210, 210, 216, 0.58);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 12px;
    transition-duration: 0.12s;
    transition-property: background-color, color;
}

.yucp-conflict-option:hover {
    color: rgba(240, 240, 244, 0.82);
}

.yucp-conflict-option-selected {
    background-color: rgba(255, 255, 255, 0.14);
    color: #f2f2f4;
}

/* ============================================================================
   FILE TREE — Export Inspector Design Language
   Depth hierarchy via colored left-border groups, clean compact rows
   ============================================================================ */

/* Outer scroll container */
.yucp-tree-scroll {
    background-color: rgba(255, 255, 255, 0.05);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
}

/* Scroll wrapper — fills remaining height, shows scrollbar for asset list only */
.yucp-tree-scroll-wrapper {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 6px;
}

/* Row — folder or file */
.yucp-tree-item {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 0;
    padding-right: 4px;
    margin-bottom: 0;
    border-radius: 4px;
    background-color: transparent;
    transition-duration: 0.10s;
    transition-property: background-color;
}

.yucp-tree-item:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Folder row — slightly bolder row tint */
.yucp-tree-folder {
    margin-top: 1px;
}

/* ── Depth group containers (children of an expanded folder) ── */
.yucp-tree-group {
    margin-left: 6px;
    padding-left: 8px;
    border-left-width: 2px;
    margin-bottom: 2px;
    border-radius: 0 0 0 4px;
}

/* Depth 1 — Teal (brand) */
.yucp-tree-group-depth-1 {
    border-left-color: rgba(54, 191, 177, 0.38);
    background-color: rgba(54, 191, 177, 0.015);
}
/* Depth 2 — Blue */
.yucp-tree-group-depth-2 {
    border-left-color: rgba(66, 135, 245, 0.38);
    background-color: rgba(66, 135, 245, 0.015);
}
/* Depth 3 — Purple */
.yucp-tree-group-depth-3 {
    border-left-color: rgba(167, 66, 245, 0.38);
    background-color: rgba(167, 66, 245, 0.015);
}
/* Depth 4 — Orange */
.yucp-tree-group-depth-4 {
    border-left-color: rgba(245, 144, 66, 0.38);
    background-color: rgba(245, 144, 66, 0.015);
}
/* Depth 5 — Rose */
.yucp-tree-group-depth-5 {
    border-left-color: rgba(245, 66, 102, 0.38);
    background-color: rgba(245, 66, 102, 0.015);
}
/* Depth 6+ — Cyan */
.yucp-tree-group-depth-6 {
    border-left-color: rgba(34, 211, 238, 0.38);
    background-color: rgba(34, 211, 238, 0.015);
}

/* Group hover — intensify the depth indicator */
.yucp-tree-group:hover { border-left-color: rgba(255, 255, 255, 0.28); }
.yucp-tree-group-depth-1:hover { border-left-color: rgba(54, 191, 177, 0.80); background-color: rgba(54, 191, 177, 0.035); }
.yucp-tree-group-depth-2:hover { border-left-color: rgba(66, 135, 245, 0.80); background-color: rgba(66, 135, 245, 0.035); }
.yucp-tree-group-depth-3:hover { border-left-color: rgba(167, 66, 245, 0.80); background-color: rgba(167, 66, 245, 0.035); }
.yucp-tree-group-depth-4:hover { border-left-color: rgba(245, 144, 66, 0.80); background-color: rgba(245, 144, 66, 0.035); }
.yucp-tree-group-depth-5:hover { border-left-color: rgba(245, 66, 102, 0.80); background-color: rgba(245, 66, 102, 0.035); }
.yucp-tree-group-depth-6:hover { border-left-color: rgba(34, 211, 238, 0.80); background-color: rgba(34, 211, 238, 0.035); }

/* Inner content row */
.yucp-tree-item-content {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-height: 24px;
    padding-left: 6px;
    min-width: 0;
}

/* Expand / collapse button */
.yucp-tree-expand-button {
    width: 18px;
    min-width: 18px;
    height: 18px;
    padding: 0;
    margin: 0;
    margin-right: 4px;
    background-color: transparent;
    border-width: 0;
    color: rgba(180, 180, 190, 0.50);
    font-size: 10px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    border-radius: 3px;
    transition-duration: 0.10s;
    transition-property: background-color, color;
}

.yucp-tree-expand-button:hover {
    color: #36BFB1;
    background-color: rgba(54, 191, 177, 0.14);
}

/* Checkbox */
.yucp-tree-checkbox {
    margin-right: 5px;
    margin-left: 0;
    flex-shrink: 0;
}

.yucp-tree-checkbox-mixed {
    opacity: 0.70;
}

/* File / folder icons */
.yucp-tree-icon {
    width: 16px;
    min-width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.yucp-tree-folder-icon {
    /* Unity folder icon image handles colour */
}

.yucp-tree-file-icon {
    color: rgba(200, 200, 210, 0.45);
}

/* Labels */
.yucp-tree-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    color: #e0e0e4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 8px;
}

.yucp-tree-folder-label {
    color: #f2f2f4;
    -unity-font-style: bold;
}

.yucp-tree-file-label {
    color: rgba(220, 220, 228, 0.80);
    -unity-font-style: normal;
}

/* Conflict / exists states */
.yucp-tree-item-exists {
    opacity: 0.68;
}

.yucp-tree-item-conflict {
    background-color: rgba(239, 68, 68, 0.06);
}

.yucp-tree-item-conflict:hover {
    background-color: rgba(239, 68, 68, 0.10);
}

/* ── Badges ── */
.yucp-tree-badge {
    margin-left: 6px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 3px;
    flex-shrink: 0;
}

.yucp-tree-badge Label {
    font-size: 9px;
    -unity-font-style: bold;
}

/* Licensed / protected badge */
.yucp-tree-badge-protected {
    background-color: rgba(99, 130, 220, 0.26);
}

.yucp-tree-badge-protected Label {
    color: rgba(210, 225, 255, 1.0);
}

/* Conflict badge (Replace / Keep) */
.yucp-tree-badge-conflict {
    background-color: rgba(239, 68, 68, 0.13);
}

.yucp-tree-badge-conflict Label {
    color: rgba(252, 130, 130, 0.92);
}

/* ============================================================================
   VERIFICATION ICON
   ============================================================================ */
.yucp-verification-icon {
    margin-left: 7px;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.yucp-verification-icon Image {
    width: 18px;
    height: 18px;
}

/* ============================================================================
   MAIN SCROLL VIEW
   ============================================================================ */
.yucp-main-scrollview {
    background-color: transparent;
}

/* ============================================================================
   RESPONSIVE
   ============================================================================ */
@media (max-width: 800px) {
    .yucp-metadata-header {
        flex-wrap: wrap;
    }

    .yucp-action-buttons-container {
        width: 100%;
        margin-left: 0;
        margin-top: 10px;
        justify-content: flex-end;
    }
}

@media (max-width: 600px) {
    .yucp-metadata-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .yucp-metadata-icon-container {
        margin-bottom: 10px;
    }

    .yucp-metadata-name-field {
        font-size: 17px;
    }

    .yucp-action-buttons-container {
        width: 100%;
        margin-left: 0;
        margin-top: 10px;
        justify-content: flex-start;
    }
}

/* ============================================================================
   LICENSE CARDS
   ============================================================================ */
.yucp-license-card {
    background-color: rgba(9, 9, 13, 0.88);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.09);
    border-right-color: rgba(255, 255, 255, 0.09);
    border-bottom-color: rgba(255, 255, 255, 0.09);
    border-left-color: rgba(255, 255, 255, 0.09);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 18px;
    padding-bottom: 18px;
    margin-top: 12px;
    transition-duration: 0.18s;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color, opacity;
}

.yucp-license-eyebrow {
    color: rgba(255, 255, 255, 0.40);
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.yucp-license-title {
    color: #f2f2f4;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.yucp-license-body {
    color: rgba(218, 218, 224, 0.76);
    font-size: 12px;
    margin-bottom: 14px;
    white-space: normal;
}

.yucp-license-button-row {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
}

.yucp-license-primary-button {
    min-height: 36px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(255, 255, 255, 0.96);
    border-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    width: 220px;
    max-width: 320px;
}

.yucp-license-primary-button-label {
    color: rgba(12, 12, 14, 0.98);
    font-size: 12px;
    -unity-font-style: bold;
}

.yucp-license-verified-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.yucp-license-verified-copy {
    color: rgba(218, 218, 224, 0.88);
    font-size: 12px;
    margin-right: 10px;
    flex-grow: 1;
}

.yucp-license-chip {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    padding-left: 0;
    padding-right: 12px;
    padding-top: 0;
    padding-bottom: 0;
    margin-right: 8px;
    margin-bottom: 6px;
}

.yucp-license-chip-count {
    min-width: 20px;
    height: 20px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.88);
    color: rgba(20, 20, 22, 0.96);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.yucp-license-chip-label {
    color: rgba(210, 210, 216, 0.66);
    font-size: 10px;
}

/* ============================================================================
   PROTECTED SUMMARY — amber left-border accent, minimal chrome
   ============================================================================ */
.yucp-protected-summary-card {
    flex-direction: column;
    background-color: rgba(250, 176, 5, 0.04);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(250, 176, 5, 0.42);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 12px;
}

.yucp-protected-summary-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(250, 176, 5, 0.65);
    margin-bottom: 0;
}

.yucp-protected-summary-count {
    font-size: 10px;
    color: rgba(250, 176, 5, 0.45);
    flex-shrink: 0;
}

.yucp-protected-stat-row {
    display: none;
}

.yucp-protected-preview-list {
    flex-direction: column;
    margin-top: 4px;
}

.yucp-protected-preview-item {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-width: 0;
    color: rgba(210, 210, 216, 0.55);
    font-size: 11px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-bottom: 0;
}

.yucp-protected-preview-icon {
    font-size: 10px;
    color: rgba(250, 176, 5, 0.45);
    margin-right: 6px;
    flex-shrink: 0;
    width: 12px;
    -unity-text-align: middle-center;
}

.yucp-protected-preview-more {
    color: rgba(210, 210, 216, 0.30);
    font-size: 10px;
    margin-top: 3px;
    padding-left: 18px;
}

/* ============================================================================
   INSTALLED PACKAGES VIEW
   ============================================================================ */
.installed-packages-view {
    flex-grow: 1;
    flex-direction: column;
    flex-shrink: 1;
    min-height: 0;
    background-color: #111114;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* Top bar — title + accent line */
.installed-packages-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.055);
    flex-shrink: 0;
}

.installed-packages-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(242, 242, 244, 0.88);
}

.installed-packages-subtitle {
    font-size: 10px;
    color: rgba(54, 191, 177, 0.70);
    margin-top: 1px;
}

/* Search + filter area */
.installed-packages-search-area {
    flex-direction: column;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 10px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.packages-view-header {
    flex-direction: column;
    margin-bottom: 0;
    flex-shrink: 0;
}

/* Search field */
.packages-search-field {
    width: 100%;
    min-height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.042);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #f2f2f4;
    margin-bottom: 8px;
    transition-duration: 0.14s;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
}

.packages-search-field:focus {
    background-color: rgba(255, 255, 255, 0.08);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-left-color: rgba(255, 255, 255, 0.14);
}

.packages-search-field > .unity-text-input {
    background-color: transparent;
    border-width: 0;
    color: #f2f2f4;
    padding-left: 0;
    padding-right: 0;
}

.packages-search-field > .unity-text-input:focus {
    background-color: transparent;
}

/* Filter row */
.packages-filter-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 2px;
}

.packages-filter-container {
    flex-direction: row;
    flex-wrap: nowrap;
}

.packages-filter-container > * {
    margin-right: 6px;
}

.packages-filter-button {
    min-width: 0;
    min-height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: rgba(210, 210, 216, 0.60);
    transition-duration: 0.12s;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color, color;
}

.packages-filter-button:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    color: rgba(240, 240, 244, 0.88);
}

.packages-filter-button-active {
    background-color: rgba(107, 159, 255, 0.14);
    border-top-color: rgba(107, 159, 255, 0.28);
    border-right-color: rgba(107, 159, 255, 0.28);
    border-bottom-color: rgba(107, 159, 255, 0.28);
    border-left-color: rgba(107, 159, 255, 0.28);
    color: #8cb4ff;
}

.packages-filter-button-active:hover {
    background-color: rgba(107, 159, 255, 0.20);
    color: #a8c8ff;
}

/* View toggle */
.packages-view-toggle {
    min-width: 0;
    min-height: 26px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: rgba(210, 210, 216, 0.60);
    transition-duration: 0.12s;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color, color;
}

.packages-view-toggle:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    color: rgba(240, 240, 244, 0.88);
}

/* Scroll / container */
.packages-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 14px;
}

.packages-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.packages-container > * {
    margin-right: 10px;
    margin-bottom: 10px;
}

.packages-container-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.packages-container-list {
    flex-direction: column;
    flex-wrap: nowrap;
}

/* ============================================================================
   PACKAGE CARD
   ============================================================================ */
.package-card {
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
    border-right-color: rgba(255, 255, 255, 0.07);
    border-bottom-color: rgba(255, 255, 255, 0.07);
    border-left-color: rgba(255, 255, 255, 0.07);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    position: relative;
    overflow: hidden;
    transition-duration: 0.16s;
    transition-property: background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
}

.package-card:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
}

.package-card:active {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Grid card */
.package-card-grid {
    width: 188px;
    min-width: 188px;
    flex-direction: column;
}

/* List card */
.package-card-list {
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* Icon */
.package-card-icon {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    flex-shrink: 0;
}

.package-card-grid .package-card-icon {
    width: 100%;
    height: 110px;
    min-height: 110px;
    margin-bottom: 0;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.package-card-icon-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.package-card-icon-placeholder {
    width: 55%;
    height: 55%;
    opacity: 0.22;
}

/* Card content */
.package-card-content {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

.package-card-list .package-card-content {
    margin-left: 13px;
}

.package-card-grid .package-card-content {
    margin-left: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 12px;
}

/* Name row */
.package-card-name-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    position: relative;
    margin-bottom: 3px;
}

.package-card-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f2f2f4;
    flex-shrink: 1;
    flex-grow: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 5px;
}

.package-card-version {
    font-size: 11px;
    color: rgba(210, 210, 216, 0.45);
    margin-top: 2px;
}

.package-card-author {
    font-size: 11px;
    color: rgba(210, 210, 216, 0.40);
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.package-card-verified-badge {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

/* Update badge — green tint */
.package-card-update-badge {
    font-size: 10px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(74, 222, 128, 0.13);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(74, 222, 128, 0.24);
    border-right-color: rgba(74, 222, 128, 0.24);
    border-bottom-color: rgba(74, 222, 128, 0.24);
    border-left-color: rgba(74, 222, 128, 0.24);
    color: #6de89e;
    -unity-font-style: normal;
    flex-shrink: 0;
}

/* Hover banner */
.package-card-hover-banner {
    overflow: hidden;
    background-color: transparent;
}

/* ============================================================================
   PACKAGE DETAILS VIEW
   ============================================================================ */
.package-details-view {
    flex-grow: 1;
    flex-direction: column;
    background-color: #111114;
}

/* Info row inside details */
.yucp-info-row {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.04);
}

.yucp-info-label {
    width: 100px;
    min-width: 100px;
    font-size: 11px;
    color: rgba(210, 210, 216, 0.40);
}

.yucp-info-value {
    flex-grow: 1;
    font-size: 11px;
    color: rgba(240, 240, 244, 0.82);
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Section title */
.yucp-section-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.30);
    margin-bottom: 12px;
}

/* File list item */
.yucp-file-item {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 3px;
    transition-duration: 0.08s;
    transition-property: background-color;
}

.yucp-file-item:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.yucp-file-item-icon {
    font-size: 11px;
    color: rgba(54, 191, 177, 0.50);
    margin-right: 8px;
    flex-shrink: 0;
    width: 14px;
    -unity-text-align: middle-center;
}

.yucp-file-item-path {
    font-size: 11px;
    color: rgba(210, 210, 216, 0.60);
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Dependency row */
.yucp-dep-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: rgba(255, 255, 255, 0.038);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-bottom: 6px;
    border-width: 0;
}

.yucp-dep-name {
    font-size: 12px;
    color: rgba(240, 240, 244, 0.80);
    flex-grow: 1;
}

.yucp-dep-version {
    font-size: 11px;
    color: rgba(107, 159, 255, 0.80);
    flex-shrink: 0;
}

/* ============================================================================
   LICENSE GATE — unified single section, no nested bubbles
   ============================================================================ */

/* Root container — sits inside the installer summary card, flows as one block */
.lgate-root {
    flex-direction: column;
    margin-top: 14px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.07);
}

/* Creator Identity row — no individual background, flows into package rows */
.lgate-id-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 8px;
}

.lgate-id-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(242, 242, 244, 0.90);
    margin-bottom: 2px;
}

.lgate-id-hint {
    font-size: 10px;
    color: rgba(218, 218, 224, 0.48);
    white-space: normal;
}

/* Section label — acts as a sub-header within the combined block */
.lgate-section-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.28);
    margin-top: 12px;
    margin-bottom: 8px;
}

/* Per-requirement verification block — no bubble, divider between entries */
.lgate-req-block {
    flex-direction: column;
    padding-left: 0;
    padding-right: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.lgate-req-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.lgate-req-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgba(242, 242, 244, 0.92);
    flex-grow: 1;
    margin-right: 12px;
}

.lgate-req-id {
    font-size: 9px;
    color: rgba(210, 210, 216, 0.30);
    margin-bottom: 8px;
}

.lgate-req-note {
    font-size: 11px;
    color: rgba(109, 232, 158, 0.72);
    white-space: normal;
}

/* Provider selection tabs */
.lgate-tab-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 10px;
}

.lgate-tab-sep {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.16);
    margin-left: 8px;
    margin-right: 8px;
}

.lgate-tab {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-bottom-color: transparent;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 4px;
    font-size: 11px;
    color: rgba(210, 210, 216, 0.44);
    transition-duration: 0.12s;
    transition-property: color, border-bottom-color;
}

.lgate-tab:hover {
    color: rgba(242, 242, 244, 0.76);
}

.lgate-tab-active {
    color: #f2f2f4;
    border-bottom-color: rgba(107, 159, 255, 0.55);
}

/* License key input row */
.lgate-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.lgate-key-field {
    flex-grow: 1;
    height: 32px;
    font-size: 11px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #f2f2f4;
}

.lgate-key-field > .unity-text-input {
    background-color: transparent;
    border-width: 0;
    color: #f2f2f4;
    padding-left: 10px;
    padding-right: 10px;
}

/* Solid button (Verify / Connect) */
.lgate-solid-btn {
    height: 32px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.09);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-left-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #f2f2f4;
    flex-shrink: 0;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.lgate-solid-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Link/ghost button (Sign out) */
.lgate-link-btn {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgba(210, 210, 216, 0.46);
    font-size: 10px;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 0;
    transition-duration: 0.10s;
    transition-property: color;
}

.lgate-link-btn:hover {
    color: rgba(242, 242, 244, 0.80);
}

/* Discord / Creator Identity verify row */
.lgate-discord-row {
    flex-direction: column;
    align-items: stretch;
    margin-top: 8px;
}

/* Discord / Creator Identity verify button — same style as lgate-solid-btn */
.lgate-discord-btn {
    height: 32px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 11px;
    background-color: rgba(255, 255, 255, 0.09);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.15);
    border-right-color: rgba(255, 255, 255, 0.15);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    border-left-color: rgba(255, 255, 255, 0.15);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    color: #f2f2f4;
    flex-shrink: 0;
    transition-duration: 0.12s;
    transition-property: background-color;
}

.lgate-discord-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.lgate-discord-note {
    font-size: 10px;
    color: rgba(210, 210, 216, 0.38);
    white-space: normal;
    margin-top: 5px;
}

/* Inline status indicator (dot + text) */
.lgate-status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.lgate-status-dot {
    width: 6px;
    height: 6px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    flex-shrink: 0;
    margin-right: 5px;
}

.lgate-status-dot-verified {
    background-color: rgba(109, 232, 158, 0.80);
}

.lgate-status-dot-unverified {
    background-color: rgba(210, 210, 216, 0.18);
}

.lgate-status-text {
    font-size: 10px;
    flex-shrink: 0;
}

.lgate-status-text-verified {
    color: rgba(109, 232, 158, 0.82);
}

.lgate-status-text-unverified {
    color: rgba(210, 210, 216, 0.40);
}

/* Footer note */
.lgate-footer {
    font-size: 10px;
    color: rgba(210, 210, 216, 0.32);
    white-space: normal;
    margin-top: 10px;
}

/* Secondary "Use license key instead" toggle link */
.lgate-key-toggle {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgba(180, 180, 192, 0.38);
    font-size: 10px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 8px;
    -unity-text-align: middle-left;
    transition-duration: 0.10s;
    transition-property: color;
}

.lgate-key-toggle:hover {
    color: rgba(210, 210, 216, 0.70);
}

/* Warning box */
.lgate-warning {
    flex-direction: column;
    background-color: rgba(239, 68, 68, 0.06);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(239, 68, 68, 0.14);
    border-right-color: rgba(239, 68, 68, 0.14);
    border-bottom-color: rgba(239, 68, 68, 0.14);
    border-left-color: rgba(239, 68, 68, 0.14);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-top: 10px;
}

.lgate-warning-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgba(252, 165, 165, 0.90);
    margin-bottom: 3px;
}

.lgate-warning-body {
    font-size: 11px;
    color: rgba(230, 196, 194, 0.72);
    white-space: normal;
}

/* Legacy: simplified flow classes kept for compatibility */
.lgate-simple { flex-direction: column; margin-top: 16px; }
.lgate-simple-verified { flex-direction: row; align-items: center; margin-top: 2px; }
.lgate-check { font-size: 13px; color: rgba(109, 232, 158, 0.85); margin-right: 6px; }
.lgate-simple-btn-row { flex-direction: row; align-items: center; margin-top: 4px; }
.lgate-eyebrow { font-size: 9px; -unity-font-style: bold; color: rgba(255,255,255,0.28); margin-bottom: 3px; }
.lgate-title { font-size: 15px; -unity-font-style: bold; color: #f2f2f4; }
.lgate-body { font-size: 11px; color: rgba(218,218,224,0.52); white-space: normal; margin-top: 4px; }
.lgate-divider { height: 0; margin-top: 8px; }

/* ============================================================================
   PRODUCT PANEL — Floating marketplace-style card
   ============================================================================ */
.yucp-product-panel {
    background-color: transparent;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 24px;
    margin-top: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.yucp-product-panel-loading {
    opacity: 0;
}

/* ---------- Header: icon + title block + CTA ---------- */
.yucp-product-header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 0;
    min-width: 0;
}

.yucp-product-title-block {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 16px;
    min-width: 0;
    overflow: hidden;
}

.yucp-product-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: #f2f2f4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.yucp-product-author {
    font-size: 12px;
    color: rgba(218, 218, 224, 0.60);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.yucp-product-tagline {
    font-size: 13px;
    color: rgba(218, 218, 224, 0.72);
    margin-top: 6px;
    white-space: normal;
    -unity-font-style: italic;
}

/* ---------- CTA column ---------- */
.yucp-cta-column {
    flex-shrink: 0;
    margin-left: 16px;
    align-items: flex-end;
}

.yucp-cta-button {
    min-width: 160px;
    min-height: 40px;
    padding-left: 20px;
    padding-right: 24px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(244, 244, 248, 0.96);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.26);
    border-right-color: rgba(255, 255, 255, 0.26);
    border-bottom-color: rgba(255, 255, 255, 0.26);
    border-left-color: rgba(255, 255, 255, 0.26);
    color: rgba(10, 10, 14, 0.96);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.16s;
}

.yucp-cta-button:hover {
    background-color: rgba(255, 255, 255, 1.0);
    color: rgba(10, 10, 14, 0.96);
    scale: 1.03 1.03;
    border-top-color: rgba(255, 255, 255, 0.38);
    border-right-color: rgba(255, 255, 255, 0.38);
    border-bottom-color: rgba(255, 255, 255, 0.38);
    border-left-color: rgba(255, 255, 255, 0.38);
}

.yucp-cta-button Label {
    color: rgba(10, 10, 14, 0.96);
    font-size: 13px;
    -unity-font-style: bold;
}

.yucp-cta-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: rgba(10, 10, 14, 0.90);
}

.yucp-cta-sublabel {
    font-size: 10px;
    color: rgba(218, 218, 224, 0.44);
    margin-top: 4px;
    -unity-text-align: middle-right;
}

.yucp-verify-status {
    font-size: 10px;
    color: rgba(180, 200, 255, 0.75);
    margin-top: 4px;
    -unity-text-align: middle-right;
    -unity-font-style: italic;
}

.dark .yucp-verify-status {
    color: rgba(180, 200, 255, 0.75);
}

.yucp-flow-notice {
    flex-shrink: 0;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
    margin-bottom: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-color: rgba(255, 255, 255, 0.035);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.dark .yucp-flow-notice {
    background-color: rgba(255, 255, 255, 0.035);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-flow-notice-info {
    background-color: rgba(255, 255, 255, 0.035);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.dark .yucp-flow-notice-info {
    background-color: rgba(255, 255, 255, 0.035);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-flow-notice-success {
    background-color: rgba(109, 232, 158, 0.055);
    border-top-color: rgba(109, 232, 158, 0.16);
    border-right-color: rgba(109, 232, 158, 0.16);
    border-bottom-color: rgba(109, 232, 158, 0.16);
    border-left-color: rgba(109, 232, 158, 0.16);
}

.dark .yucp-flow-notice-success {
    background-color: rgba(109, 232, 158, 0.055);
    border-top-color: rgba(109, 232, 158, 0.16);
    border-right-color: rgba(109, 232, 158, 0.16);
    border-bottom-color: rgba(109, 232, 158, 0.16);
    border-left-color: rgba(109, 232, 158, 0.16);
}

.yucp-flow-notice-error {
    background-color: rgba(239, 68, 68, 0.06);
    border-top-color: rgba(239, 68, 68, 0.16);
    border-right-color: rgba(239, 68, 68, 0.16);
    border-bottom-color: rgba(239, 68, 68, 0.16);
    border-left-color: rgba(239, 68, 68, 0.16);
}

.dark .yucp-flow-notice-error {
    background-color: rgba(239, 68, 68, 0.06);
    border-top-color: rgba(239, 68, 68, 0.16);
    border-right-color: rgba(239, 68, 68, 0.16);
    border-bottom-color: rgba(239, 68, 68, 0.16);
    border-left-color: rgba(239, 68, 68, 0.16);
}

.yucp-flow-notice-title {
    color: rgba(244, 244, 248, 0.92);
    font-size: 11px;
    -unity-font-style: bold;
}

.dark .yucp-flow-notice-title {
    color: rgba(244, 244, 248, 0.92);
}

.yucp-flow-notice-body {
    color: rgba(224, 224, 230, 0.70);
    font-size: 11px;
    white-space: normal;
    margin-top: 3px;
}

.dark .yucp-flow-notice-body {
    color: rgba(224, 224, 230, 0.70);
}

.yucp-cta-cancel {
    min-width: 70px;
    min-height: 40px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    font-size: 11px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    color: rgba(240, 240, 244, 0.60);
    transition-property: background-color, color;
    transition-duration: 0.14s;
}

.yucp-cta-cancel:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(240, 240, 244, 0.85);
}

/* ---------- Chip row & chips ---------- */
.yucp-chip-row {
    flex-direction: row;
    flex-wrap: nowrap;
    overflow: hidden;
    margin-top: 12px;
    margin-bottom: 2px;
}

.yucp-chip {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.yucp-chip Label {
    font-size: 11px;
    color: rgba(218, 218, 224, 0.80);
}

.yucp-chip-category {
    background-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-chip-category Label {
    color: rgba(218, 218, 224, 0.80);
}

.yucp-chip-platform {
    background-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-chip-platform Label {
    color: rgba(218, 218, 224, 0.80);
}

.yucp-chip-content {
    background-color: rgba(255, 255, 255, 0.04);
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
}

.yucp-chip-content Label {
    color: rgba(218, 218, 224, 0.80);
}

/* Overflow indicator chip — shown when tag count exceeds max */
.yucp-chip-overflow {
    background-color: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    border-bottom-color: rgba(255, 255, 255, 0.06);
    border-left-color: rgba(255, 255, 255, 0.06);
}

.yucp-chip-overflow Label {
    color: rgba(218, 218, 224, 0.40);
    font-size: 10px;
}

/* Package description — always visible, clipped to ~3 lines */
.yucp-meta-description {
    font-size: 12px;
    color: rgba(218, 218, 224, 0.60);
    white-space: normal;
    overflow: hidden;
    max-height: 58px;
    margin-top: 8px;
    margin-bottom: 2px;
}

/* Chip overflow "+N" tooltip popup */
.yucp-chip-tooltip {
    position: absolute;
    background-color: rgba(18, 18, 24, 0.97);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    padding-left: 12px;
    padding-right: 14px;
    padding-top: 9px;
    padding-bottom: 9px;
    min-width: 110px;
    max-width: 220px;
    flex-direction: column;
}

.yucp-chip-tooltip-row {
    flex-direction: row;
    align-items: center;
    padding-top: 3px;
    padding-bottom: 3px;
}

.yucp-chip-tooltip-dot {
    color: rgba(218, 218, 224, 0.30);
    font-size: 14px;
    margin-right: 7px;
    flex-shrink: 0;
}

.yucp-chip-tooltip-label {
    color: rgba(218, 218, 224, 0.80);
    font-size: 11px;
    white-space: nowrap;
}

.yucp-chip-slide-up {
    translate: 0 4px;
    opacity: 0;
}

/* ---------- Info sections ---------- */
.yucp-info-section-block {
    margin-top: 16px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.yucp-info-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.28);
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.yucp-info-section-body {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.yucp-info-section-text {
    font-size: 12px;
    color: rgba(218, 218, 224, 0.68);
    white-space: normal;
    margin-bottom: 4px;
}

.yucp-asset-stat {
    font-size: 11px;
    color: rgba(218, 218, 224, 0.72);
    margin-right: 4px;
}

.yucp-asset-stat-separator {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.18);
    margin-right: 4px;
}

.yucp-requirement-text {
    font-size: 11px;
    color: rgba(218, 218, 224, 0.56);
    margin-top: 4px;
    white-space: normal;
}

/* ---------- Creator section ---------- */
.yucp-creator-note {
    font-size: 12px;
    color: rgba(218, 218, 224, 0.68);
    white-space: normal;
    -unity-font-style: italic;
    margin-bottom: 8px;
}

.yucp-creator-links {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.yucp-creator-link-button {
    width: 28px;
    height: 28px;
    margin-right: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: transparent;
    transition-property: opacity;
    transition-duration: 0.14s;
    opacity: 0.60;
}

.yucp-creator-link-button:hover {
    opacity: 1.0;
}

/* ---------- Release notes ---------- */
.yucp-release-notes-text {
    font-size: 11px;
    color: rgba(218, 218, 224, 0.60);
    white-space: normal;
}

/* ---------- Show-more toggle button ---------- */
.yucp-show-more-button {
    align-self: flex-start;
    margin-top: 10px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 11px;
    color: rgba(218, 218, 224, 0.55);
    background-color: rgba(255, 255, 255, 0.04);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.yucp-show-more-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(218, 218, 224, 0.85);
}

/* ---------- Gallery strip ---------- */
.yucp-gallery-strip {
    flex-direction: row;
    margin-top: 14px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    overflow: hidden;
}

.yucp-gallery-thumb {
    width: 80px;
    height: 48px;
    min-width: 80px;
    min-height: 48px;
    margin-right: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-size: cover;
    background-position: center;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.08);
    opacity: 0.72;
    transition-property: opacity, border-color;
    transition-duration: 0.16s;
}

.yucp-gallery-thumb:hover {
    opacity: 1.0;
    border-top-color: rgba(54, 191, 177, 0.50);
    border-right-color: rgba(54, 191, 177, 0.50);
    border-bottom-color: rgba(54, 191, 177, 0.50);
    border-left-color: rgba(54, 191, 177, 0.50);
}

.yucp-gallery-thumb-selected {
    opacity: 1.0;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgba(54, 191, 177, 0.80);
    border-right-color: rgba(54, 191, 177, 0.80);
    border-bottom-color: rgba(54, 191, 177, 0.80);
    border-left-color: rgba(54, 191, 177, 0.80);
}

/* ---------- Verification badge inline ---------- */
.yucp-product-verified-badge {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    flex-shrink: 0;
}

/* ============================================================================
   INSTALLER ROOT — single-page, no-scroll container
   ============================================================================ */
.yucp-installer-root {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

/* ============================================================================
   BANNER SECTION — in normal flow (position: relative), contains hero overlay
   ============================================================================ */
.yucp-banner-section {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 160px;
    width: 100%;
    overflow: hidden;
}

/* ============================================================================
   HERO OVERLAY — absolute, pinned to bottom of banner section
   ============================================================================ */
.yucp-hero-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: flex-end;
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 16px;
}

.yucp-hero-icon {
    width: 62px;
    height: 62px;
    min-width: 62px;
    min-height: 62px;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    overflow: hidden;
    flex-shrink: 0;
    margin-right: 13px;
    margin-bottom: 2px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.20);
    border-right-color: rgba(255, 255, 255, 0.20);
    border-bottom-color: rgba(255, 255, 255, 0.20);
    border-left-color: rgba(255, 255, 255, 0.20);
    background-color: rgba(0, 0, 0, 0.18);
    align-items: center;
    justify-content: center;
}

.yucp-hero-icon-text {
    color: rgba(255, 255, 255, 0.96);
    font-size: 22px;
    -unity-font-style: bold;
}

.yucp-hero-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 2px;
}

.yucp-hero-name-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.yucp-hero-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
    min-width: 0;
}

.yucp-hero-meta {
    font-size: 11px;
    color: rgba(240, 240, 244, 0.68);
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.yucp-hero-tagline {
    font-size: 12px;
    color: rgba(232, 232, 238, 0.76);
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-font-style: italic;
}

/* ============================================================================
   METADATA SECTION — compact 2-column grid below the banner
   ============================================================================ */
.yucp-metadata-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 0;
}

.yucp-meta-grid {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 10px;
}

.yucp-meta-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
}

.yucp-meta-col-right {
    margin-left: 16px;
}

.yucp-meta-section {
    flex-shrink: 0;
    margin-bottom: 10px;
}

.yucp-meta-section-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.26);
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.yucp-meta-section-body {
    font-size: 11px;
    color: rgba(218, 218, 224, 0.68);
    white-space: normal;
    overflow: hidden;
}

