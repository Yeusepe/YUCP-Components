

.live-grip-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 4px;
}

.live-grip-row-label {
    width: 38%;
    min-width: 100px;
    color: var(--yucp-text-secondary);
}


.live-grip-note {
    margin-left: 3px;
    margin-bottom: 6px;
    color: var(--yucp-text-tertiary);
    font-size: 11px;
    white-space: normal;
}


.live-grip-segmented {
    flex-direction: row;
    flex-grow: 1;
    min-height: 26px;
    padding: 2px;
    border-radius: var(--yucp-radius-input);
    background-color: var(--yucp-bg-tertiary);
}

.live-grip-segment {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 22px;
    margin: 0;
    border-width: 0;
    border-radius: var(--yucp-radius-small);
    background-color: rgba(0, 0, 0, 0);
    color: var(--yucp-text-secondary);
    -unity-text-align: middle-center;
}

.live-grip-segment:hover {
    background-color: var(--yucp-bg-active);
    color: var(--yucp-text-primary);
}

.live-grip-segment--selected,
.live-grip-segment--selected:hover {
    background-color: var(--yucp-accent-primary);
    color: var(--yucp-text-primary);
    -unity-font-style: bold;
}


.live-grip-list {
    border-width: 1px;
    border-color: var(--yucp-border-secondary);
    border-radius: var(--yucp-radius-input);
    background-color: var(--yucp-bg-secondary);
}

.live-grip-list .unity-collection-view__item--selected {
    background-color: rgba(54, 191, 177, 0.25);
}

.live-grip-list-item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 8px;
}

.live-grip-list-item-name {
    flex-grow: 1;
    color: var(--yucp-text-primary);
}

.live-grip-empty {
    padding: 6px 3px;
    color: var(--yucp-text-tertiary);
    white-space: normal;
}

.live-grip-footer {
    flex-direction: row;
    margin-top: 4px;
    margin-bottom: 10px;
}

.live-grip-icon-button {
    width: 28px;
    height: 24px;
    margin: 0 4px 0 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--yucp-radius-small);
    background-color: var(--yucp-bg-tertiary);
    align-items: center;
    justify-content: center;
}

.live-grip-icon-button:hover {
    background-color: var(--yucp-bg-active);
}

.live-grip-icon-button > Image {
    width: 16px;
    height: 16px;
}


.live-grip-detail {
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--yucp-border-secondary);
}

.live-grip-edit {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 6px 0 8px 0;
}

.live-grip-edit > Image {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.live-grip-finger {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px;
    border-radius: var(--yucp-radius-small);
}

.live-grip-finger:hover {
    background-color: var(--yucp-bg-active);
}

.live-grip-finger--selected,
.live-grip-finger--selected:hover {
    background-color: rgba(54, 191, 177, 0.18);
}

.live-grip-finger-name {
    width: 70px;
    color: var(--yucp-text-primary);
}

.live-grip-finger-spacer {
    flex-grow: 1;
}
