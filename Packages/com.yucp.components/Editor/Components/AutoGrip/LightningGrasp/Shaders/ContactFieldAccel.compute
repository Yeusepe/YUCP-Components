// Contact Field Acceleration Compute Shader
// GPU-accelerated BVH traversal and interaction matrix computation

#pragma kernel TraverseContactField
#pragma kernel ComputeInteractionMatrix
#pragma kernel ReduceLinkInteraction

// BVH Node structure (matches C# struct)
struct BVHNode
{
    float3 boundsMin;
    float3 boundsMax;
    int leftChild;
    int rightChild;
    int patchId;
    int firstSample;
    int sampleCount;
    int padding;
};

// Buffers
StructuredBuffer<BVHNode> _BVHNodes;
StructuredBuffer<float4> _SamplePositions;
StructuredBuffer<float4> _SampleNormals;
StructuredBuffer<int> _SamplePatchIds;
StructuredBuffer<float> _AngleRanges;

// Object data
StructuredBuffer<float3> _ObjectPoints;
StructuredBuffer<float3> _ObjectNormals;

// Output
RWStructuredBuffer<int> _InteractionMatrix;     // [numPatches * numObjectPoints]
RWStructuredBuffer<int> _NearestHandPointIdx;   // [numPatches * numObjectPoints]
RWStructuredBuffer<int> _LinkInteractionMatrix; // [numLinks * numObjectPoints]

// Parameters
int _NumNodes;
int _NumSamples;
int _NumPatches;
int _NumObjectPoints;
int _NumLinks;
float _MaxContactDistance;
float _AngleThreshold; // cos(max_angle)

// Per-link patch mapping
StructuredBuffer<int> _LinkToPatchStart;    // [numLinks + 1]
StructuredBuffer<int> _LinkToPatches;       // [sum of patches per link]

// Stack for iterative BVH traversal
#define MAX_STACK_DEPTH 32

[numthreads(64, 1, 1)]
void TraverseContactField(uint3 id : SV_DispatchThreadID)
{
    uint objectPointIdx = id.x;
    if (objectPointIdx >= (uint)_NumObjectPoints) return;
    
    float3 objPoint = _ObjectPoints[objectPointIdx];
    float3 objNormal = _ObjectNormals[objectPointIdx];
    
    // Iterative BVH traversal with stack
    int stack[MAX_STACK_DEPTH];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // Root node
    
    while (stackPtr > 0)
    {
        int nodeIdx = stack[--stackPtr];
        if (nodeIdx < 0 || nodeIdx >= _NumNodes) continue;
        
        BVHNode node = _BVHNodes[nodeIdx];
        
        // AABB intersection test
        float3 closest = clamp(objPoint, node.boundsMin, node.boundsMax);
        float dist = length(objPoint - closest);
        if (dist > _MaxContactDistance) continue;
        
        // Check if leaf
        if (node.leftChild < 0 && node.rightChild < 0)
        {
            // Process samples in leaf
            for (int i = node.firstSample; i < node.firstSample + node.sampleCount; i++)
            {
                float3 samplePos = _SamplePositions[i].xyz;
                float3 sampleNormal = _SampleNormals[i].xyz;
                
                // Distance check
                float sampleDist = length(samplePos - objPoint);
                if (sampleDist > _MaxContactDistance) continue;
                
                // Normal alignment: finger normal should face opposite to object normal
                float dotProduct = dot(sampleNormal, -objNormal);
                int patchId = _SamplePatchIds[i];
                float angleRange = _AngleRanges[patchId];
                
                if (dotProduct < cos(angleRange)) continue;
                
                // Mark interaction
                int matrixIdx = patchId * _NumObjectPoints + objectPointIdx;
                InterlockedMax(_InteractionMatrix[matrixIdx], 1);
                
                // Track nearest hand point
                // (simplified: just store sample index, actual implementation would track distance)
                _NearestHandPointIdx[matrixIdx] = i;
            }
        }
        else
        {
            // Push children to stack
            if (node.rightChild >= 0 && stackPtr < MAX_STACK_DEPTH)
            {
                stack[stackPtr++] = node.rightChild;
            }
            if (node.leftChild >= 0 && stackPtr < MAX_STACK_DEPTH)
            {
                stack[stackPtr++] = node.leftChild;
            }
        }
    }
}

// Compute full interaction matrix (alternative kernel without BVH for small cases)
[numthreads(8, 8, 1)]
void ComputeInteractionMatrix(uint3 id : SV_DispatchThreadID)
{
    uint patchIdx = id.x;
    uint objectPointIdx = id.y;
    
    if (patchIdx >= (uint)_NumPatches || objectPointIdx >= (uint)_NumObjectPoints) return;
    
    float3 objPoint = _ObjectPoints[objectPointIdx];
    float3 objNormal = _ObjectNormals[objectPointIdx];
    
    bool hasInteraction = false;
    int nearestIdx = -1;
    float nearestDist = 1e10;
    
    // Find samples for this patch (linear search, suboptimal)
    for (int i = 0; i < _NumSamples; i++)
    {
        if (_SamplePatchIds[i] != (int)patchIdx) continue;
        
        float3 samplePos = _SamplePositions[i].xyz;
        float3 sampleNormal = _SampleNormals[i].xyz;
        
        float dist = length(samplePos - objPoint);
        if (dist > _MaxContactDistance) continue;
        
        float dotProduct = dot(sampleNormal, -objNormal);
        float angleRange = _AngleRanges[patchIdx];
        if (dotProduct < cos(angleRange)) continue;
        
        hasInteraction = true;
        if (dist < nearestDist)
        {
            nearestDist = dist;
            nearestIdx = i;
        }
    }
    
    int matrixIdx = patchIdx * _NumObjectPoints + objectPointIdx;
    _InteractionMatrix[matrixIdx] = hasInteraction ? 1 : 0;
    _NearestHandPointIdx[matrixIdx] = nearestIdx;
}

// Reduce interaction matrix from patches to links
[numthreads(64, 1, 1)]
void ReduceLinkInteraction(uint3 id : SV_DispatchThreadID)
{
    uint objectPointIdx = id.x;
    if (objectPointIdx >= (uint)_NumObjectPoints) return;
    
    for (int linkIdx = 0; linkIdx < _NumLinks; linkIdx++)
    {
        int patchStart = _LinkToPatchStart[linkIdx];
        int patchEnd = _LinkToPatchStart[linkIdx + 1];
        
        int hasInteraction = 0;
        
        for (int p = patchStart; p < patchEnd; p++)
        {
            int patchId = _LinkToPatches[p];
            int matrixIdx = patchId * _NumObjectPoints + objectPointIdx;
            if (_InteractionMatrix[matrixIdx] > 0)
            {
                hasInteraction = 1;
                break;
            }
        }
        
        int linkMatrixIdx = linkIdx * _NumObjectPoints + objectPointIdx;
        _LinkInteractionMatrix[linkMatrixIdx] = hasInteraction;
    }
}
